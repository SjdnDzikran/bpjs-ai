# ====================
# ===== APPLICATION =====
# ====================
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/car_inspection_ai?schema=public"

# ====================
# ===== WAHA INTEGRATION =====
# ====================
# HMAC secret key for webhook verification (must match WAHA's WHATSAPP_HOOK_HMAC_KEY)
# Generate with: openssl rand -hex 32
WAHA_WEBHOOK_SECRET=your-secret-key-here

# WAHA API Configuration (for sending messages)
WAHA_API_URL=http://localhost:3000
WAHA_API_KEY=your-waha-api-key-here

# ====================
# ===== AI CONFIGURATION =====
# ====================
# Google AI API Key for Gemini
GOOGLE_AI_API_KEY=your-google-ai-api-key-here